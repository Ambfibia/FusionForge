  "findings": [
    {
      "classification": "conversion artifact",
      "contract": "Both native cinematics hardcoded npc_dexter, bypassing the repaired NPC table. Primary InitMode selects Mob/npc_dexter2.kfm, texture/npc_dexter.dds and texture/npc_dexter2_face_0.dds."
    },
    {
      "classification": "primary parity",
      "contract": "NameEvent requests observe then cutscene_stand_1; TutorialEvent requests excellent, deedeeno then busyrun. Both InitMode branches initialize stand1. The new model has no inven clip."
    },
    {
      "classification": "owner-requested native extension",
      "contract": "Resolve Dexter/Dee Dee/Computress through native NPC 728/701/730, including GLB, main/sub texture overrides, samplers and table scale. Preserve cinematic transforms and animation ownership."
    },
    {
      "classification": "owner-selected historical retention",
      "contract": "Ordinary Dee Dee still resolves through retained row 701 (npc_deedee). Fusion Dee Dee is unaffected."
    },
    {
      "classification": "implementation correction during verification",
      "contract": "Plain Image preloads for table override paths competed with glTF sampler settings for Dee Dee/Computress. Removed these preloads; the existing table texture binder owns exact sampler/color-space loading. The scene barrier additionally waits until bound image assets exist and reports material conversion errors."
    }
  ],
