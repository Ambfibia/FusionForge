  ],
  "hypotheses": [
    {
      "claim": "Preserving prefab world scale is sufficient for vertical hand contact.",
      "status": "rejected",
      "reason": "Owner identified a remaining height mismatch; GPU transforms measure a mean wrist-height gap of about 0.10 native units."
    },
    {
      "claim": "Matching wrist origins is sufficient for visible palm height.",
      "status": "rejected",
      "reason": "Wrist-aligned GPU captures pass the wrist metric but differently sized hands place their palms at different heights; use the middle-finger base at each palm edge."
    }
  ],
  "differences": [
    {
      "classification": "owner-requested native extension",
      "description": "Align the mean height of the monkey and player palm grip points (Bip01 L/R Finger2) every animated frame. This is an owner-requested native correction, not a claim about primary script behavior."
    }
  ],
  "nativeContract": {
    "ownership": "Resolve exact monkey hand hierarchy paths once on scene readiness and canonical player hand paths through NativePlayerRigBones; release with the traversal attachment.",
    "schedule": "After AnimationSystems and before TransformSystems::Propagate; TransformHelper samples current local transforms.",
    "translation": "Convert the world-Y palm midpoint height error into the socket parent local vector and apply only that translation.",
    "preserved": [
      "scale",
      "rotation",
      "world X/Z placement",
      "source animation clips",
      "player controller pose",
      "network movement authority"
    ]
  },
  "conclusion": "Vertical palm alignment passes on both production gender rigs. Mean height error is below 0.000001 native units; individual grip height differences are below 0.001 native units in the captured poses. Horizontal pose, scale and original clips are preserved; this is a height constraint, not full arm IK.",
